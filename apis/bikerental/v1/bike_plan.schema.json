{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/apis/bikerental/v1/bike_plan.schema.json",
  "title": "BikePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bike_id",
    "pickup_station",
    "dropoff_station",
    "estimated_pickup",
    "estimated_dropoff"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "bike_id": {
      "type": "string"
    },
    "pickup_station": {
      "$ref": "#/$defs/StationCode"
    },
    "dropoff_station": {
      "$ref": "#/$defs/StationCode"
    },
    "estimated_pickup": {
      "$ref": "#/$defs/Timestampz"
    },
    "estimated_dropoff": {
      "$ref": "#/$defs/Timestampz"
    }
  },
  "$defs": {
    "StationCode": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{1,14}[A-Z0-9]$",
      "description": "Station code using 3-16 uppercase alphanumeric characters and optional dashes."
    },
    "Timestampz": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp with time zone in RFC 3339 date-time format."
    }
  }
}
