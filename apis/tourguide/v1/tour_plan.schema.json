{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/apis/tourguide/v1/tour_plan.schema.json",
  "title": "TourPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tour_id",
    "location",
    "estimated_start",
    "estimated_end"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "tour_id": {
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/Address"
    },
    "estimated_start": {
      "$ref": "#/$defs/Timestampz"
    },
    "estimated_end": {
      "$ref": "#/$defs/Timestampz"
    }
  },
  "$defs": {
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "street",
        "house_number",
        "city",
        "postal_code",
        "country_code"
      ],
      "properties": {
        "street": {
          "type": "string"
        },
        "house_number": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code."
        }
      }
    },
    "Timestampz": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp with time zone in RFC 3339 date-time format."
    }
  }
}
